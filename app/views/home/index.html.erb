<div class="container-fluid bg-dark min-vh-100 d-flex align-items-center justify-content-center">
  <div class="card bg-secondary bg-opacity-10 border-secondary shadow-sm" style="height: 50rem; width: 80rem;">
    <div class="card-body p-4 d-flex flex-column">
      <h3 class="text-center text-light mb-4">
        Player Management System
      </h3>
      <div class="card-body p-4 table-responsive overflow-auto" style="max-height: 70vh;">
        <table class="table table-hover table-dark" style="table-layout: fixed; width: 100%;">
          <colgroup>
            <col style="width: 11%">
            <col style="width: 40%">
            <col style="width: 20%">
            <col style="width: 20%">
            <col style="width: 9%">
          </colgroup>
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col">Member</th>
              <th scope="col">Steam64ID</th>
              <th scope="col">Discord</th>
              <th scope="col">Activity</th>
            </tr>
          </thead>
          <tbody>
            <% @Users.each do |user| %>
              <tr>
                <td>
                  <div class="d-flex gap-1">
                    <%= link_to "Edit", edit_user_path(user.id), class: "btn btn-warning btn-sm" %>
                    <%= link_to "Delete", delete_user_path(user.id), class: "btn btn-danger btn-sm" %>
                  </div>
                </td>
                <td>
                  <div class="text-truncate">
                    <%= user.name %>
                  </div>
                </td>
                <td>
                  <div class="text-truncate">
                    <%= user.steam_id %>
                  </div>
                </td>
                <td>
                  <div class="text-truncate">
                    <%= user.discord %>
                  </div>
                </td>
                <td>
                  <div class="text-truncate">
                    <%= form_with model: user do |f| %>
                      <%= f.select :activity,
                                   ["Active", "LOA", "Reserve"],
                                   {},
                                   class: "form-control bg-dark text-center text-light border-secondary",
                                   onchange: "this.form.submit();" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="card-footer d-flex justify-content-center gap-3">
        <%= link_to "Add User", new_user_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>