<div class="container-fluid bg-dark min-vh-100 d-flex align-items-center justify-content-center">
  <div class="card bg-secondary bg-opacity-10 border-secondary shadow-sm" style="width: 30rem;">
    <div class="card-body p-4">

      <h3 class="text-center text-light mb-4">
        Edit Player
      </h3>

      <%= form_with model: @user do |f| %>

        <div class="mb-3">
          <%= f.label :name, class: "text-light" %>
          <%= f.text_field :name,
                           class: "form-control bg-dark text-light border-secondary",
                           placeholder: :name %>
        </div>

        <div class="mb-3">
          <%= f.label :steam_id, "Steam64 ID", class: "text-light" %>
          <%= f.text_field :steam_id,
                           class: "form-control bg-dark text-light border-secondary",
                           placeholder: :steam_id %>
        </div>

        <div class="mb-3">
          <%= f.label :discord, class: "text-light" %>
          <%= f.text_field :discord,
                           class: "form-control bg-dark text-light border-secondary",
                           placeholder: :discord %>
        </div>

        <div class="d-flex justify-content-center gap-3">
          <%= f.submit "Edit Player", class: "btn btn-primary" %>

          <%= link_to "Cancel",
                      root_path,
                      class: "btn btn-secondary" %>
        </div>

      <% end %>

    </div>
  </div>
</div>
