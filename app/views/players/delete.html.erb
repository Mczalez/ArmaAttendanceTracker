<div class="container-fluid bg-dark min-vh-100 d-flex align-items-center justify-content-center">
  <div class="card bg-secondary bg-opacity-10 border-secondary shadow-sm" style="width: 30rem;">
    <div class="card-body p-4">

      <h3 class="text-center text-light mb-4">
        Delete Player
      </h3>

      <p class="text-center text-light mb-4">
        To delete the player, type in their name:
        <br><br>
        <strong><%= @player.name %></strong>
        <br>
        <%= flash[:alert] %>
      </p>

      <%= form_with model: @player, method: :delete do |f| %>

        <div class="mb-3">
          <%= f.label :name, class: "text-light" %>
          <%= text_field_tag :name, nil, class: "form-control bg-dark text-light border-secondary" %>
        </div>



        <div class="d-flex justify-content-center gap-3">
          <%= f.submit "Delete Player", class: "btn btn-primary" %>

          <%= link_to "Cancel",
                      players_path(unit_id: @unit.id),
                      class: "btn btn-secondary" %>
        </div>

      <% end %>

    </div>
  </div>
</div>
