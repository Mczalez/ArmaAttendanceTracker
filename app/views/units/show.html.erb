<div class="container-fluid bg-dark min-vh-100 d-flex align-items-center justify-content-center">
  <div class="card bg-secondary bg-opacity-10 border-secondary shadow-sm" style="width: 30rem;">
    <div class="card-body p-4 text-center">
      <h3 class="text-light mb-4"><%= @unit.name %></h3>

      <div class="d-flex justify-content-center gap-3">
        <%= link_to "Access Roster", players_path(unit_id: @unit.id), class: "btn btn-primary" %>
        <%= link_to "Back to Units", units_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>
